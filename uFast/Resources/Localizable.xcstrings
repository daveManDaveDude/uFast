    "settings.live-activity.support" : { "comment" : "Settings automatic Live Activities supporting copy", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show elapsed time, goal progress and target on the Lock Screen and Dynamic Island when a fast starts. Each Live Activity stays active for up to 8 hours. If your fast is still active, uFast can show a new one the next time you open the app." } } } },
    "settings.live-activity.explanation" : { "comment" : "Settings automatic Live Activities explanation", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn this off to hide the current Live Activity and prevent new ones. You can also choose Hide for this fast without changing the setting for future fasts." } } } },
