    "live-activity.disclosure.message" : { "comment" : "Live Activity disclosure explanation", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows uFast, elapsed time, goal progress and target on the Lock Screen and Dynamic Island for up to 8 hours. You can hide it at any time. Your fast continues if the activity ends." } } } },
    "live-activity.status.unsupported" : { "comment" : "Live Activity unsupported status", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live Activities aren’t available on this iPhone." } } } },
